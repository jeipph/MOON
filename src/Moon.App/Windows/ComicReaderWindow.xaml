<Window x:Class="Moon.App.Windows.ComicReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Moon.App.ViewModels"
        xmlns:local="clr-namespace:Moon.App.Windows"
        xmlns:conv="clr-namespace:Moon.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ComicReaderViewModel}"
        Title="{Binding Title}"
        Icon="/Assets/moon.ico"
        Width="{DynamicResource Size.Reader.Width}"
        Height="{DynamicResource Size.Reader.Height}"
        MinWidth="{DynamicResource Size.Window.MinWidth}"
        MinHeight="{DynamicResource Size.Window.MinHeight}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Main}"
        FontSize="{DynamicResource FontSize.Body}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="Is" />
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="{DynamicResource Size.TopBar}" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="BottomRow" Height="{DynamicResource Size.ReaderBottom}" />
        </Grid.RowDefinitions>

        <!-- Barra superior: título y página, vista, zoom y pantalla completa -->
        <Border Grid.Row="0"
                Padding="{DynamicResource Padding.TopBar}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource ChoiceToggle}"
                                  AutomationProperties.Name="Marcar zona"
                                  ToolTip="Arrastra sobre la página para marcar una zona y escribir una nota"
                                  IsChecked="{Binding IsMarking}"
                                  Content="Marcar zona" />
                    <Button Style="{StaticResource IconButton}" AutomationProperties.Name="Añadir marcador" ToolTip="Marcador en esta página"
                            Command="{Binding AddBookmarkCommand}" Content="&#xE8A4;" />
                    <ToggleButton Style="{StaticResource IconToggle}" AutomationProperties.Name="Notas" ToolTip="Zonas, notas y marcadores"
                                  IsChecked="{Binding IsNotesOpen}" Content="&#xE70B;" Margin="0,0,12,0" />
                    <Button Style="{StaticResource IconButton}" AutomationProperties.Name="Alejar" ToolTip="Alejar (Ctrl −)" Command="{Binding ZoomOutCommand}" Content="&#xE71F;" />
                    <Button Style="{StaticResource ChipButton}" AutomationProperties.Name="Zoom" ToolTip="Volver al 100 % (Ctrl 0)" Command="{Binding ResetZoomCommand}" Content="{Binding ZoomText}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" AutomationProperties.Name="Acercar" ToolTip="Acercar (Ctrl +)" Command="{Binding ZoomInCommand}" Content="&#xE8A3;" />
                    <ToggleButton x:Name="ViewButton"
                                  Margin="{DynamicResource Space.Gap}"
                                  Style="{StaticResource IconToggle}"
                                  AutomationProperties.Name="Vista"
                                  ToolTip="Una o dos páginas, manga, ajustes de imagen"
                                  Content="&#xE8A1;" />
                    <Button Style="{StaticResource IconButton}"
                            AutomationProperties.Name="Pantalla completa"
                            ToolTip="Pantalla completa (F11)"
                            Click="OnFullScreenClick"
                            Content="&#xE740;" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="{DynamicResource FontSize.Small}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               AutomationProperties.AutomationId="Pagina"
                               Text="{Binding PageText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Opciones de vista -->
        <Popup Grid.Row="0"
               PlacementTarget="{Binding ElementName=ViewButton}"
               Placement="Bottom"
               HorizontalOffset="-260"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=ViewButton}">
            <Border Width="{DynamicResource Size.SettingsPanel}"
                    Padding="{DynamicResource Padding.Popup}"
                    Background="{DynamicResource Brush.Background}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Control}"
                    TextElement.Foreground="{DynamicResource Brush.Text}"
                    TextElement.FontFamily="{DynamicResource Font.Main}">
                <StackPanel>
                    <TextBlock Text="Vista" Foreground="{DynamicResource Brush.TextMuted}" FontSize="{DynamicResource FontSize.Small}" />
                    <WrapPanel Margin="{DynamicResource Space.SettingsRow}">
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="Layout" Content="Una página" IsChecked="{Binding Layout, Converter={StaticResource Is}, ConverterParameter=Single}" />
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="Layout" Content="Doble" IsChecked="{Binding Layout, Converter={StaticResource Is}, ConverterParameter=Double}" />
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="Layout" Content="Webtoon" IsChecked="{Binding Layout, Converter={StaticResource Is}, ConverterParameter=Webtoon}" />
                    </WrapPanel>

                    <TextBlock Text="Dirección (este cómic)" Foreground="{DynamicResource Brush.TextMuted}" FontSize="{DynamicResource FontSize.Small}" />
                    <WrapPanel Margin="{DynamicResource Space.SettingsRow}">
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="Direction" Content="Cómic  →" IsChecked="{Binding Direction, Converter={StaticResource Is}, ConverterParameter=LeftToRight}" />
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="Direction" Content="Manga  ←" IsChecked="{Binding Direction, Converter={StaticResource Is}, ConverterParameter=RightToLeft}" />
                    </WrapPanel>

                    <TextBlock Text="Ajustar" Foreground="{DynamicResource Brush.TextMuted}" FontSize="{DynamicResource FontSize.Small}" />
                    <WrapPanel Margin="{DynamicResource Space.SettingsRow}">
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="Fit" Content="Página entera" IsChecked="{Binding Fit, Converter={StaticResource Is}, ConverterParameter=Page}" />
                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="Fit" Content="Al ancho" IsChecked="{Binding Fit, Converter={StaticResource Is}, ConverterParameter=Width}" />
                    </WrapPanel>

                    <TextBlock Text="Imagen (este cómic)" Foreground="{DynamicResource Brush.TextMuted}" FontSize="{DynamicResource FontSize.Small}" />
                    <Grid Margin="{DynamicResource Space.SettingsRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Brillo" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="{DynamicResource FontSize.Small}" />
                        <Slider Grid.Row="0" Grid.Column="1" Style="{StaticResource ProgressSlider}" AutomationProperties.Name="Brillo"
                                Minimum="-100" Maximum="100" SmallChange="5" LargeChange="10" Value="{Binding Brightness, Delay=150}" />
                        <TextBlock Grid.Row="1" Text="Contraste" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="{DynamicResource FontSize.Small}" />
                        <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource ProgressSlider}" AutomationProperties.Name="Contraste"
                                Minimum="-100" Maximum="100" SmallChange="5" LargeChange="10" Value="{Binding Contrast, Delay=150}" />
                        <TextBlock Grid.Row="2" Text="Gamma" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="{DynamicResource FontSize.Small}" />
                        <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource ProgressSlider}" AutomationProperties.Name="Gamma"
                                Minimum="50" Maximum="200" SmallChange="5" LargeChange="10" Value="{Binding Gamma, Delay=150}" />
                    </Grid>
                    <WrapPanel>
                        <ToggleButton Style="{StaticResource ChoiceToggle}" AutomationProperties.Name="Quitar amarillo"
                                      ToolTip="Vuelve blanco el papel amarillento de los escaneos viejos"
                                      Content="Quitar amarillo" IsChecked="{Binding Whiten}" />
                        <Button Style="{StaticResource ChipButton}" Content="Restablecer" Command="{Binding ResetAdjustmentsCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Panel de notas (a la derecha de las páginas) -->
        <Border Grid.Row="1"
                HorizontalAlignment="Right"
                Panel.ZIndex="1"
                Width="{DynamicResource Size.SettingsPanel}"
                Background="{DynamicResource Brush.Background}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsNotesOpen, Converter={StaticResource Visible}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="{DynamicResource Padding.Sidebar}" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Small}"
                               Foreground="{DynamicResource Brush.TextMuted}" Text="NOTAS" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Content="Exportar…"
                            AutomationProperties.Name="Exportar notas" Click="OnExportClick" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="{DynamicResource Padding.Sidebar}" TextWrapping="Wrap" x:Name="NotesHint"
                           FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextMuted}"
                           Text="Pulsa «Marcar zona» y arrastra sobre la página para señalar un bocadillo, un personaje o lo que quieras." />
                <ListBox x:Name="NotesList"
                         AutomationProperties.Name="Lista de notas"
                         ItemsSource="{Binding Annotations}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseLeftButtonUp="OnNoteClicked"
                         MouseDoubleClick="OnNoteDoubleClicked">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AnnotationItemViewModel}">
                            <Grid AutomationProperties.Name="{Binding Text}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{DynamicResource Size.ColorBar.Grid}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding ColorBrush}" CornerRadius="2" />
                                <StackPanel Grid.Column="1" Margin="{DynamicResource Space.Gap}">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontStyle="Italic"
                                               Margin="{DynamicResource Space.AboveSmall}" Foreground="{DynamicResource Brush.TextMuted}"
                                               Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="{Binding Where}" Margin="{DynamicResource Space.AboveSmall}"
                                               FontSize="{DynamicResource FontSize.Micro}" Foreground="{DynamicResource Brush.TextMuted}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Editar nota…" Click="OnEditNoteClick" />
                            <MenuItem Header="Eliminar" Click="OnDeleteNoteClick" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Páginas -->
        <Grid x:Name="PageArea" Grid.Row="1" Background="{DynamicResource Brush.Surface}" ClipToBounds="True">
            <!-- Una página o doble: se puede acercar y arrastrar -->
            <ScrollViewer x:Name="PagedScroller"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="OnPagedWheel"
                          PreviewMouseLeftButtonDown="OnPageMouseDown"
                          PreviewMouseMove="OnPageMouseMove"
                          PreviewMouseLeftButtonUp="OnPageMouseUp">
                <StackPanel x:Name="SpreadPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
            </ScrollViewer>

            <!-- Webtoon: todas las páginas en una columna; solo se cargan las que se ven -->
            <ListBox x:Name="WebtoonList"
                     Visibility="Collapsed"
                     Background="Transparent"
                     BorderThickness="0"
                     Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Standard"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.ScrollChanged="OnWebtoonScrolled"
                     PreviewMouseWheel="OnWebtoonWheel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Center" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:WebtoonPage}">
                        <Image Width="{Binding Width}"
                               Height="{Binding Height}"
                               Source="{Binding Image}"
                               Loaded="OnWebtoonPageLoaded"
                               Unloaded="OnWebtoonPageUnloaded" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="ErrorText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Visibility="Collapsed" />
        </Grid>

        <!-- Páginas: arrastrar para saltar -->
        <Border Grid.Row="2"
                Padding="{DynamicResource Padding.TopBar}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Right"
                           Margin="{DynamicResource Space.Gap}"
                           FontSize="{DynamicResource FontSize.Small}"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Text="{Binding PageText}" />
                <!-- En manga la barra va al revés (la primera página a la derecha). -->
                <Slider x:Name="PageSlider"
                        Style="{StaticResource ProgressSlider}"
                        AutomationProperties.Name="Página"
                        Minimum="0"
                        Maximum="{Binding LastPage, Mode=OneTime}"
                        IsDirectionReversed="{Binding IsRightToLeft}"
                        Value="{Binding CurrentPage, Mode=OneWay}"
                        Thumb.DragCompleted="OnSliderDragCompleted"
                        PreviewMouseLeftButtonUp="OnSliderClicked" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
