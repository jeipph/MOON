<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Tamaños, espacios y letras de MOON (no dependen del tema). Mismo esquema que NOX. -->

    <!-- Ventana principal -->
    <sys:Double x:Key="Size.Window.Width">1100</sys:Double>
    <sys:Double x:Key="Size.Window.Height">720</sys:Double>
    <sys:Double x:Key="Size.Window.MinWidth">640</sys:Double>
    <sys:Double x:Key="Size.Window.MinHeight">420</sys:Double>

    <!-- Barra superior -->
    <GridLength x:Key="Size.TopBar">52</GridLength>
    <Thickness x:Key="Padding.TopBar">20,0,12,0</Thickness>

    <!-- Controles -->
    <sys:Double x:Key="Size.IconButton">36</sys:Double>
    <CornerRadius x:Key="Radius.Control">10</CornerRadius>
    <Thickness x:Key="Padding.Chip">10,4,10,4</Thickness>
    <Thickness x:Key="Space.Gap">8,0,0,0</Thickness>
    <Thickness x:Key="Space.Above">0,8,0,0</Thickness>

    <!-- Letras -->
    <FontFamily x:Key="Font.Main">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="FontSize.Logo">16</sys:Double>
    <sys:Double x:Key="FontSize.Heading">22</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Small">12</sys:Double>
    <sys:Double x:Key="FontSize.Icon">16</sys:Double>
    <sys:Double x:Key="FontSize.EmptyIcon">48</sys:Double>
</ResourceDictionary>
