<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colores del tema oscuro (ver docs/04-UI-THEME.md). Mismos nombres en Tokens.Light.xaml. -->
    <SolidColorBrush x:Key="Brush.Background" Color="#000000" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#141414" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Brush.Border" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Brush.Text" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF5A5A" />

</ResourceDictionary>
